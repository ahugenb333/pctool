<Page x:Class="PcTool.App.Views.BenchmarksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Benchmarks"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="24,12,24,24">
        <TextBlock Text="Benchmarks" FontSize="28" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Compare against" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding State.ComparePresetOptions}" DisplayMemberPath="Label"
                      SelectedValuePath="Id" SelectedValue="{Binding ComparePresetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      MinWidth="140" />
        </StackPanel>
        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding IndexCaption}" TextWrapping="Wrap" />

        <ui:Card Margin="0,16,0,0">
            <StackPanel>
                <WrapPanel>
                    <CheckBox Content="CPU" IsChecked="{Binding RunCpu}" Margin="0,0,16,0" />
                    <CheckBox Content="Memory" IsChecked="{Binding RunMemory}" Margin="0,0,16,0" />
                    <CheckBox Content="Disk" IsChecked="{Binding RunDisk}" Margin="0,0,16,0" />
                    <CheckBox Content="GPU 3D" IsChecked="{Binding RunGpu}" Margin="0,0,16,0" />
                    <CheckBox Content="Show GPU stress during run" IsChecked="{Binding ShowGpuStressDuringRun}" Margin="0,0,16,0" />
                    <ui:ToggleSwitch Content="Quick run (noisier)" IsChecked="{Binding Quick}" />
                </WrapPanel>
                <DockPanel Margin="0,12,0,0">
                    <TextBlock Text="Disk test folder" VerticalAlignment="Center" Margin="0,0,12,0" DockPanel.Dock="Left" />
                    <ui:TextBox Text="{Binding DiskDirectory, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Folder on the drive to test" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button Content="Run benchmarks" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Command="{Binding RunCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="View GPU stress test" Icon="{ui:SymbolIcon Eye24}" Command="{Binding PreviewGpuArenaCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Cancel" Command="{Binding CancelCommand}" />
                </StackPanel>
                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Stage}" Style="{StaticResource Caption}" />
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" Margin="0,6,0,0" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <ui:InfoBar Title="Benchmark failed" Message="{Binding Error}" Severity="Error" IsOpen="True" IsClosable="False" Margin="0,12,0,0"
                    Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

        <TextBlock Text="{Binding ResultsTitle}" Style="{StaticResource SectionHeader}" />
        <ItemsControl ItemsSource="{Binding Results}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8" Padding="16,12" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="140" />
                                <ColumnDefinition Width="Auto" MinWidth="96" />
                                <ColumnDefinition Width="Auto" MinWidth="52" />
                                <ColumnDefinition Width="Auto" MinWidth="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,12,0" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Score}" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Typical}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,8,0,0">
                                <ProgressBar Value="{Binding Fraction, Mode=OneWay}" Maximum="1" Height="6"
                                             Visibility="{Binding ShowIndexBar, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="History" Style="{StaticResource SectionHeader}" />
        <Grid Margin="16,0,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="When" Style="{StaticResource Caption}" />
            <TextBlock Grid.Column="1" Text="CPU single" Style="{StaticResource Caption}" />
            <TextBlock Grid.Column="2" Text="CPU multi" Style="{StaticResource Caption}" />
            <TextBlock Grid.Column="3" Text="GPU 3D" Style="{StaticResource Caption}" />
            <TextBlock Grid.Column="4" Text="Disk read" Style="{StaticResource Caption}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding History}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="16,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding When}" />
                        <TextBlock Grid.Column="1" Text="{Binding CpuSingle}" />
                        <TextBlock Grid.Column="2" Text="{Binding CpuMulti}" />
                        <TextBlock Grid.Column="3" Text="{Binding Gpu}" />
                        <TextBlock Grid.Column="4" Text="{Binding Disk}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
