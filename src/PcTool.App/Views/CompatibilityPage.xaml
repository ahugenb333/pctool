<Page x:Class="PcTool.App.Views.CompatibilityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Compatibility"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="24,12,24,24">
        <TextBlock Text="Will it fit?" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                   Text="Checks a part against your PC: socket, chipset and BIOS, memory type and slots, power supply, PCIe, M.2 slots and case clearance. Details the app can't detect (PSU, case) can be entered in Settings." />

        <Grid Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search parts (e.g. 9070, B850, DDR4)..."
                        Icon="{ui:SymbolIcon Search24}" Margin="0,0,12,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="0,0,12,0" />
            <ui:ToggleSwitch Grid.Column="2" Content="Hide incompatible" IsChecked="{Binding OnlyCompatible}" />
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <ListBox ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart}" Height="560" Margin="0,0,12,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center"
                                     Fill="{Binding Overall, Converter={StaticResource CheckStatusToBrush}}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Price}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                    <Run Text="{Binding Category, Mode=OneWay}" /> · <Run Text="{Binding Specs, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ui:Card Grid.Column="1" VerticalAlignment="Top" VerticalContentAlignment="Top"
                     Visibility="{Binding SelectedPart, Converter={StaticResource NullToCollapsed}}">
                <StackPanel DataContext="{Binding SelectedPart}">
                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Specs}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Price}" Margin="0,2,0,0" Visibility="{Binding Price, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Text="{Binding OverallText}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8"
                               Foreground="{Binding Overall, Converter={StaticResource CheckStatusToBrush}}" />
                    <ItemsControl ItemsSource="{Binding Report.Checks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="0,4,0,0"
                                             Fill="{Binding Status, Converter={StaticResource CheckStatusToBrush}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Rule}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Part.Notes}" Style="{StaticResource Caption}" Margin="0,12,0,0"
                               Visibility="{Binding Part.Notes, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </ui:Card>
        </Grid>

        <TextBlock Text="{Binding DataNotice}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
    </StackPanel>
</Page>
